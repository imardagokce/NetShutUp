<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">

  <assemblyIdentity
      version="0.1.0.0"
      processorArchitecture="*"
      name="NetShutUp.Legacy"
      type="win32"/>

  <description>NetShutUp Legacy — network settings manager for Windows 7/8/8.1</description>

  <!-- Declare compatibility with every OS we support.
       Without these GUIDs, GetVersionExW returns wrong values on 8.1+.
       We use RtlGetVersion, but the manifest is still required for other
       Windows behaviours (DPI, file dialogs, etc.) to work correctly. -->
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 7 -->
      <supportedOS Id="{35138b9a-5d96-4fbd-8e2d-a2440225f93a}"/>
      <!-- Windows 8 -->
      <supportedOS Id="{4a2f28e3-53b9-4441-ba9c-d69d4a4a6e38}"/>
      <!-- Windows 8.1 -->
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}"/>
    </application>
  </compatibility>

  <!-- UAC: request elevation when the command requires it.
       The default is asInvoker; elevation is requested programmatically
       via ShellExecuteEx when apply/revert/selftest are invoked. -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>

</assembly>
