{
  "id": "privacy",
  "name": "Privacy",
  "description": "Less telemetry and fewer name leaks on the local network",
  "settings": [
    { "id": "service.diagtrack", "set": { "start_type": 4 } },
    { "id": "privacy.telemetry_level", "set": { "dword": 0 } },
    { "id": "dns.llmnr", "set": { "dword": 0 } },
    { "id": "update.delivery_optimization", "set": { "dword": 0 } },
    { "id": "firewall.domain.enabled", "set": { "dword": 1 } },
    { "id": "firewall.domain.inbound", "set": { "dword": 0 } },
    { "id": "firewall.private.enabled", "set": { "dword": 1 } },
    { "id": "firewall.private.inbound", "set": { "dword": 0 } },
    { "id": "firewall.public.enabled", "set": { "dword": 1 } },
    { "id": "firewall.public.inbound", "set": { "dword": 0 } }
  ],
  "optional": [
    {
      "id": "firewall.rule.block_telemetry",
      "set": { "dword": 1 },
      "question": "Block the Windows telemetry service from connecting out (adds a firewall rule that is removed again on revert)?"
    },
    {
      "id": "firewall.public.network_discovery",
      "set": { "dword": 0 },
      "question": "Turn off network discovery rules on Public networks? Other devices will no longer find this computer on public Wi-Fi."
    },
    {
      "id": "firewall.public.file_printer_sharing",
      "set": { "dword": 0 },
      "question": "Turn off file and printer sharing rules on Public networks? Sharing and printers will not work on public networks."
    },
    {
      "id": "firewall.public.remote_assistance",
      "set": { "dword": 0 },
      "question": "Turn off Remote Assistance rules on Public networks?"
    }
  ],
  "dns": { "providers": ["quad9", "cloudflare"], "choose": "first_working" }
}
